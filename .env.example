# SN Connect configuration. Copy to .env for local development.
# Production values are set in the deployment environment (Canadian region).

# --- Database (operational data only; never confidential content) ---
# Local development: SQLite. Production: PostgreSQL in a Canadian region,
# e.g. postgresql://user:pass@host:5432/snconnect (also change the provider
# in prisma/schema.prisma to "postgresql").
DATABASE_URL="file:./dev.db"

# --- Authentication ---
# "dev-bypass": simulated users from config/dev-users.ts, no external calls.
# "entra": real Microsoft Entra ID sign-in (requires the values below).
AUTH_MODE="dev-bypass"
# 32+ random bytes, base64. Signs session cookies and device tokens.
AUTH_SECRET="dev-secret-change-me-please-32-bytes-x"
# Entra app registration (required when AUTH_MODE=entra)
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""
# Entra security group object IDs mapped to application roles
GROUP_PS_MEMBERS=""
GROUP_PS_SUPERVISORS=""
GROUP_PS_MANAGERS=""
GROUP_PS_CALLCENTRE=""
GROUP_PS_ADMINS=""

# --- Sessions ---
# Field sessions expire at end of shift or this many hours, whichever first
SESSION_FIELD_MAX_HOURS="14"
# Desk sessions expire on a daily cycle
SESSION_DESK_MAX_HOURS="24"
MAX_SESSIONS_PER_USER="3"

# --- Storage ---
# "mock": local directory with JSON metadata sidecars (development/demo).
# "graph": Microsoft Graph -> SharePoint (requires tenant approval).
STORAGE_ADAPTER="mock"
MOCK_STORAGE_DIR="./.mock-storage"

# --- Reporting ---
# Counts below this are suppressed or rolled up in reports (admin-editable)
SUPPRESSION_THRESHOLD="5"

# --- Queue ---
# Warn the user and notify supervisors when a pending item is older than this
QUEUE_AGE_WARN_MINUTES="120"
